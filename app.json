{
  "expo": {
    "name": "HearthCoach",
    "slug": "hearthcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hearthcoach",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0b0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.laganinii.hearthcoach",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick a Battlegrounds screenshot to get coach advice.",
        "NSCameraUsageDescription": "Optional: capture a board screenshot for advice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0b0f"
      },
      "package": "com.laganinii.hearthcoach"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a Battlegrounds screenshot to get coach advice."
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "REPLACE_AFTER_EAS_INIT" } }
  }
}
